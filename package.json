{
  "name": "diagram-js-direct-editing",
  "version": "3.6.0",
  "description": "Direct editing support for diagram-js",
  "scripts": {
    "all": "run-s lint test generate-types",
    "dev": "npm run test -- --auto-watch --no-single-run",
    "lint": "eslint .",
    "generate-types": "run-s generate-types:*",
    "generate-types:generate": "del-cli \"lib/**/*.d.ts\" \"lib/**/*.d.ts.map\" && bio-dts -r lib --declarationMap",
    "generate-types:test": "tsc --noEmit --noImplicitAny",
    "test": "karma start",
    "prepublishOnly": "run-s generate-types"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bpmn-io/diagram-js-direct-editing"
  },
  "keywords": [
    "diagram-js",
    "diagram-js-plugin"
  ],
  "engines": {
    "node": "*"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "author": "bpmn.io",
  "license": "MIT",
  "devDependencies": {
    "bio-dts": "^0.16.0",
    "chai": "^6.2.2",
    "del-cli": "^7.0.0",
    "diagram-js": "^15.27.3",
    "eslint": "^9.39.5",
    "eslint-plugin-bpmn-io": "^2.4.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher-2": "^3.3.0",
    "karma-firefox-launcher": "^2.1.3",
    "karma-mocha": "^2.0.1",
    "karma-tldr-reporter": "^1.0.0",
    "karma-webpack": "^5.0.1",
    "mocha": "^12.0.2",
    "mocha-test-container-support": "^0.2.0",
    "npm-run-all2": "^9.0.3",
    "sinon": "^22.1.0",
    "sinon-chai": "^4.0.0",
    "typescript": "^5.9.3",
    "webpack": "^5.111.1"
  },
  "dependencies": {
    "min-dash": "^5.0.0",
    "min-dom": "^5.3.0"
  },
  "peerDependencies": {
    "diagram-js": "*"
  },
  "files": [
    "lib",
    "!lib/**/*.spec.ts"
  ],
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
